# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Signs sessions and public patient links. Generate once, then never change it
# (changing it logs everyone out). The app refuses to start without it in
# production.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# production | development | testing
APP_ENV=production

# Public URL of the deployment. Used to build LINE links and QR codes, and to
# decide whether cookies are marked Secure.
BASE_URL=https://your-domain.com

# SQLite file. On Render/Railway this MUST live on a persistent disk,
# otherwise every deploy wipes the patient data.
DB_PATH=/var/data/medtrack.db

# ---------------------------------------------------------------------------
# Hospital identity (shown to patients)
# ---------------------------------------------------------------------------
HOSPITAL_NAME=โรงพยาบาลสุไหงปาดี
HOSPITAL_PHONE=

# ---------------------------------------------------------------------------
# First admin account (created only when the staff table is empty)
# ---------------------------------------------------------------------------
# Leave BOOTSTRAP_ADMIN_PASSWORD empty and the app generates a random password
# and prints it once in the startup log, then requires a change at first login.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# LINE Messaging API (optional — every LINE feature degrades gracefully)
# ---------------------------------------------------------------------------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Shared code a pharmacist types in LINE to start receiving symptom alerts and
# to reply with "A01+message". Leave empty to disable staff registration.
LINE_STAFF_REGISTER_CODE=

# ---------------------------------------------------------------------------
# Behaviour (all optional, sensible defaults shown)
# ---------------------------------------------------------------------------
SESSION_HOURS=8
SESSION_IDLE_MINUTES=0
COOKIE_SECURE=            # defaults to true when BASE_URL is https
CSRF_ENABLED=true
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

ENABLE_SCHEDULER=true
REMINDER_FIRST_HOUR=18
REMINDER_FIRST_MINUTE=0
REMINDER_SECOND_HOUR=19
REMINDER_SECOND_MINUTE=30
MARK_MISSED_HOUR=21
MARK_MISSED_MINUTE=0

# Warn the patient when their tablets will run out within this many days.
LOW_STOCK_THRESHOLD=7
# Remind about an INR appointment this many days ahead.
INR_DUE_REMINDER_DAYS=3

LOG_LEVEL=INFO
# Comma-separated origins; leave empty to disable CORS entirely (recommended).
ALLOWED_ORIGINS=
